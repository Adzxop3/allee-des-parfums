{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "import": "node --env-file=.env --max-old-space-size=4096 src/import.js",
    "make-admin": "node --env-file-if-exists=.env src/make-admin.js",
    "db:backup": "node --env-file-if-exists=.env src/db-backup.js",
    "db:restore": "node --env-file-if-exists=.env src/db-restore.js",
    "db:verify": "node --env-file-if-exists=.env src/db-verify.js",
    "test": "node test/setup-db.js && node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
