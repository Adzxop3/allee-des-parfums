# Port de l'API Express (en production, l'hébergeur le fournit)
PORT=3001

# --- Base de données ---
# En local : connexion par les variables PG*
PGHOST=localhost
PGPORT=5432
PGDATABASE=parfums
PGUSER=postgres
PGPASSWORD=change_moi

# En production : l'adresse complète fournie par l'hébergeur (prioritaire sur les PG* si définie), ex. Neon :
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/parfums?sslmode=require

# Dossier des outils PostgreSQL (pg_dump, pg_restore) s'ils ne sont pas dans le PATH
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# --- Adresse du site (liens envoyés par email) ---
APP_URL=http://localhost:5173
# En production : APP_URL=https://votre-site.onrender.com

# --- Envoi d'emails (SMTP) ---
# Sans SMTP_HOST, les emails sont affichés dans la console du serveur (développement).
# En production c'est indispensable : sans email confirmé, personne ne peut publier.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Parfums <no-reply@exemple.com>"

# --- Production ---
# Cookies de session en HTTPS uniquement, en-têtes de sécurité stricts, site React servi par l'API
# NODE_ENV=production

# Nombre de proxys devant l'API (1 sur Render), pour l'adresse IP réelle des visiteurs (limites de tentatives).
# Laisser vide en développement.
# TRUST_PROXY=1
