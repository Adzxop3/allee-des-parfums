# Port de l'API Express
PORT=3001

# Connexion PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=parfums
PGUSER=postgres
PGPASSWORD=change_moi

# Adresse du site (liens envoyés par email)
APP_URL=http://localhost:5173

# Envoi d'emails (SMTP). Sans SMTP_HOST, les emails sont affichés dans la console du serveur.
# SMTP_HOST=smtp.exemple.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Parfums <no-reply@exemple.com>"

# En production : cookies de session envoyés uniquement en HTTPS
# NODE_ENV=production

# Nombre de proxys devant l'API (ex. 1 derrière un reverse proxy HTTPS), pour la limite de tentatives.
# Laisser vide en développement.
# TRUST_PROXY=1
